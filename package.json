{
  "name": "mindbody-hubspot-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:mapping": "npx --yes tsx lib/mapping/validate.self-check.ts",
    "validate:transform": "npx --yes tsx lib/mapping/transform.self-check.ts",
    "validate:runtime": "npx --yes tsx lib/sync/runtime-rules.self-check.ts",
    "validate:cutoff": "npx --yes tsx lib/sync/cutoff.self-check.ts",
    "validate:queue": "npx --yes tsx lib/queue/message.self-check.ts",
    "validate:dispatch": "npx --yes tsx lib/queue/dispatch.self-check.ts",
    "validate:oauth": "npx --yes tsx lib/hubspot/oauth.self-check.ts",
    "validate:all": "npx --yes tsx scripts/run-validate-all.ts",
    "verify:infra": "npx --yes tsx scripts/verify-infra.ts --mode static",
    "verify:infra:all": "npx --yes tsx scripts/verify-infra.ts --mode all",
    "mindbody:webhook-test": "npx --yes tsx scripts/trigger-mindbody-webhook.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1109.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/functions": "^3.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.5.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
